{
  "schema_version": 1,
  "description": "Logical data zones and ownership for committed pipeline inputs.",
  "zones": {
    "curated": "Human-reviewed framework configuration or geographic reference data.",
    "derived": "Deterministically rebuilt from other committed inputs.",
    "ingested": "Normalized snapshot retrieved from an external authority.",
    "research": "Sourced diagnostics used by private-property reports, not Provision.",
    "example": "Synthetic interface example; never used as truthful model data."
  },
  "datasets": {
    "air_noise_corridors.csv": {"zone": "curated", "producer": "manual geometric proxy", "authority": "framework research"},
    "air_quality.csv": {"zone": "ingested", "producer": "models/ingest_nea_air.py", "authority": "NEA"},
    "archetype_assignments.csv": {"zone": "curated", "producer": "human review", "authority": "framework specification"},
    "bca_permits.csv": {"zone": "derived", "producer": "models/ingest_bca_permits.py", "authority": "pipeline_data.json"},
    "bus_routes.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "LTA"},
    "buyer_profiles.example.json": {"zone": "example", "producer": "models/buyer_profile_model.py contract", "authority": "none"},
    "chas.csv": {"zone": "ingested", "producer": "models/fetch_chas.py", "authority": "CHAS / OneMap"},
    "childcare.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "ECDA / data.gov.sg"},
    "coastal.csv": {"zone": "derived", "producer": "models/ingest_coastal.py", "authority": "curated blue-infrastructure anchors"},
    "community.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "People's Association / data.gov.sg"},
    "covered_linkway.csv": {"zone": "ingested", "producer": "reviewed static conversion", "authority": "LTA DataMall"},
    "eldercare.csv": {"zone": "ingested", "producer": "reviewed static conversion", "authority": "AIC / MOH"},
    "estates.csv": {"zone": "curated", "producer": "human review", "authority": "framework geography"},
    "expressways.csv": {"zone": "curated", "producer": "reviewed static conversion", "authority": "OpenStreetMap"},
    "flood_risk.csv": {"zone": "ingested", "producer": "reviewed static conversion", "authority": "PUB"},
    "hawker_v2.csv": {"zone": "derived", "producer": "models/ingest_hawker_v2.py", "authority": "markets.csv + curated stall counts"},
    "hdb_density.csv": {"zone": "ingested", "producer": "models/ingest_hdb_density.py", "authority": "HDB / data.gov.sg"},
    "hdb_resale.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "HDB / data.gov.sg"},
    "jtc_industrial.csv": {"zone": "curated", "producer": "models/ingest_jtc_industrial.py", "authority": "JTC published zones"},
    "judged_inputs.csv": {"zone": "curated", "producer": "human review after momentum_model.py", "authority": "framework review gate"},
    "katong_project_profiles.csv": {"zone": "research", "producer": "human research", "authority": "linked official project sources"},
    "markets.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "NEA / data.gov.sg"},
    "mrt_layer.csv": {"zone": "ingested", "producer": "models/onemap_geocode_mrt.py", "authority": "LTA / OneMap"},
    "mrt_layer_names.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "LTA / data.gov.sg"},
    "parks.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "NParks / data.gov.sg"},
    "pipeline_data.json": {"zone": "curated", "producer": "network ingesters + human review", "authority": "reviewed public announcements"},
    "poiz_east_project_profiles.csv": {"zone": "research", "producer": "human research", "authority": "linked official project sources"},
    "polyclinics.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "MOH / data.gov.sg"},
    "school_selectivity.csv": {"zone": "research", "producer": "human research", "authority": "linked unofficial demand proxies"},
    "schools.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "MOE / data.gov.sg"},
    "sport.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "SportSG / data.gov.sg"},
    "supermarkets.csv": {"zone": "ingested", "producer": "models/data_ingest.py", "authority": "SFA / data.gov.sg"},
    "town_council_kpi.json": {"zone": "ingested", "producer": "models/ingest_tcmr.py", "authority": "MND Town Council Management Report"},
    "tree_canopy.csv": {"zone": "derived", "producer": "models/ingest_tree_canopy.py", "authority": "parks.csv + MSS"},
    "ura_private.csv": {"zone": "ingested", "producer": "scrapers/ingest_ura_raw.py", "authority": "URA PMI"}
  }
}
