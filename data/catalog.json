{
  "schema_version": 1,
  "description": "Logical data zones and ownership for committed pipeline inputs.",
  "zones": {
    "curated": "Human-reviewed framework configuration or geographic reference data.",
    "derived": "Deterministically rebuilt from other committed inputs.",
    "ingested": "Normalized snapshot retrieved from an external authority.",
    "research": "Sourced diagnostics used by private-property reports, not Provision.",
    "example": "Synthetic interface example; never used as truthful model data."
  },
  "datasets": {
    "air_noise_corridors.csv": {"zone": "curated", "producer": "manual geometric proxy", "authority": "framework research"},
